{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local",
          "limit": {
            "context": 4096,
            "output": 1024
          }
        }
      }
    }
  },
  "enabled_providers": ["ollama"],
  "share": "disabled",
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 6,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      },
      "share": false
    },
    "local-guide-a": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:../ab/system-a.txt}",
      "steps": 8,
      "temperature": 0.2,
      "options": { "seed": 42 },
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "external_directory": "deny"
      },
      "share": false
    },
    "local-guide-b": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:../ab/system-b.txt}",
      "steps": 8,
      "temperature": 0.2,
      "options": { "seed": 42 },
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "external_directory": "deny"
      },
      "share": false
    }
  }
}
