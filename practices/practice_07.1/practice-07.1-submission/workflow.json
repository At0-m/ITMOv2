      "parameters": {
        "model": {
          "__rl": true,
          "value": "={{ $('PR Context').first().json.reviewVariant === 'other' ? 'gpt-5-mini' : 'gpt-5.2' }}",
          "mode": "id"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -16,
        128
      ],
      "id": "5d2ce5da-ee42-42c0-88b6-44a705c4cff1",
      "name": "OpenAI Chat Model2"
    },
    {
      "parameters": {
        "jsCode": "const comments = $input.all().map(({ json }, index) => {\n  const { path, line, side } =\n    $('Split Diff Blocks').itemMatching(index).json;\n\n  const body = json.text?.trim();\n  if (!body) {\n    throw new Error(`Пустой комментарий для ${path}:${line}`);\n  }\n\n  return { path, line, side, body };\n});\n\nconst isOther = $('PR Context').first().json.reviewVariant === 'other';\nconst model = isOther ? 'gpt-5-mini' : 'gpt-5.2';\n\nreturn [{\n  json: {\n    event: 'COMMENT',\n    body: `AI review · ${model} · ${comments.length} блок(а) diff`,\n    comments,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
